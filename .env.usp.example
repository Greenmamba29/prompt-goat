# Universal Scraper Protocol (USP) Configuration
# Copy this file to .env and fill in your credentials

# =============================================================================
# AIRTABLE CONFIGURATION
# =============================================================================
# Get your API key from: https://airtable.com/account
AIRTABLE_API_KEY=your_airtable_api_key_here

# Your Airtable base ID (found in the URL: https://airtable.com/appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table name in your Airtable base (default: Prompts)
AIRTABLE_TABLE_NAME=Prompts

# =============================================================================
# SELENIUM CONFIGURATION
# =============================================================================
# Run browser in headless mode (true/false)
SELENIUM_HEADLESS=true

# =============================================================================
# EXPORT CONFIGURATION
# =============================================================================
# Default directory for exports
USP_EXPORT_DIR=usp_exports

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
USP_LOG_LEVEL=INFO

# =============================================================================
# METRICMULE SPECIFIC (if needed)
# =============================================================================
# Add any MetricMule-specific configuration here
# METRICMULE_API_KEY=your_key_here
